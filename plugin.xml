<?xml version="1.0" encoding="utf-8"?>
<plugin 
    id="com.yourcompany.pluginwifiprinter" 
    version="1.0.0" 
    xmlns="http://apache.org/cordova/ns/plugins/1.0"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <name>PluginWifiPrinter</name>

    <!-- JS Bridge -->
    <js-module name="PluginWifiPrinter" src="www/PluginWifiPrinter.js">
        <clobbers target="cordova.plugins.PluginWifiPrinter" />
    </js-module>

    <!-- Android -->
    <platform name="android">
        <config-file target="res/xml/config.xml" parent="/*">
            <feature name="PluginWifiPrinter">
                <param name="android-package" value="com.yourcompany.pluginwifiprinter.PluginWifiPrinter" />
            </feature>
        </config-file>

        <config-file target="AndroidManifest.xml" parent="/*">
            <uses-permission android:name="android.permission.INTERNET" />
            <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
            <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
            <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
        </config-file>

        <resource-file src="src/android/libs/printer-lib-3.2.0.aar" target="libs/printer-lib-3.2.0.aar" />
        <framework src="src/android/printer-sdk.gradle" custom="true" type="gradleReference" />

        <source-file src="src/android/PluginWifiPrinter.java" target-dir="src/com/yourcompany/pluginwifiprinter" />
    </platform>

    <!-- iOS -->
    <platform name="ios">
        <config-file target="config.xml" parent="/*">
            <feature name="PluginWifiPrinter">
                <param name="ios-package" value="PluginWifiPrinter" />
            </feature>
        </config-file>

        <!-- Xprinter iOS PrinterSDK v2.3.0 (TCP/LAN POS) -->
        <header-file src="src/ios/XprinterSDK/Headers/POSPrinterSDK.h" />
        <header-file src="src/ios/XprinterSDK/Headers/POSWIFIManager.h" />
        <header-file src="src/ios/XprinterSDK/Headers/POSBLEManager.h" />
        <header-file src="src/ios/XprinterSDK/Headers/POSCommand.h" />
        <header-file src="src/ios/XprinterSDK/Headers/POSPrinter.h" />
        <header-file src="src/ios/XprinterSDK/Headers/POSImageTranster.h" />
        <header-file src="src/ios/XprinterSDK/Headers/PrinterProfile.h" />
        <header-file src="src/ios/XprinterSDK/Headers/PTable.h" />
        <header-file src="src/ios/XprinterSDK/Headers/WIFIConnecter.h" />
        <header-file src="src/ios/XprinterSDK/Headers/CPCLCommand.h" />
        <header-file src="src/ios/XprinterSDK/Headers/ZPLCommand.h" />
        <header-file src="src/ios/XprinterSDK/Headers/KDS_Log.h" />
        <header-file src="src/ios/XprinterSDK/Headers/TSCBLEManager.h" />
        <header-file src="src/ios/XprinterSDK/Headers/TSCCommand.h" />
        <header-file src="src/ios/XprinterSDK/Headers/TSCPrinterSDK.h" />
        <header-file src="src/ios/XprinterSDK/Headers/TSCWIFIManager.h" />
        <header-file src="src/ios/XprinterSDK/Headers/LabelDocument.h" />
        <header-file src="src/ios/XprinterSDK/Headers/LabelImageTranster.h" />
        <framework src="src/ios/XprinterSDK/libPrinterSDK.a" custom="true" />

        <header-file src="src/ios/PluginWifiPrinter.h" />
        <source-file src="src/ios/PluginWifiPrinter.m" />

    </platform>

</plugin>

